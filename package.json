{
  "name": "beads-ui-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @herbcaudill/beads-ui dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "pnpm -r test",
    "test:e2e": "pnpm build && playwright test",
    "test:pack": "pnpm build && tsx apps/beads-ui/scripts/test-packed.ts",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.10.1",
    "oxfmt": "^0.53.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.17"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.12.4"
}
