    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@beads/mcp": "workspace:*",
    "@beads/sdk": "workspace:*",
    "@beads/server": "workspace:*",
    "@beads/ui": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^24.10.1",
    "get-port": "^7.1.0",
    "open": "^10.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.17"
  },
  "engines": {
    "node": ">=22"
  }
}
