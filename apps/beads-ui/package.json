{
  "name": "@herbcaudill/beads-ui",
  "version": "0.3.0",
  "description": "A polished local web UI for Beads tasks",
  "license": "MIT",
  "author": "Herb Caudill",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HerbCaudill/beads-ui.git",
    "directory": "apps/beads-ui"
  },
  "bin": {
    "beads-ui": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "dev": "tsx src/dev.ts",
